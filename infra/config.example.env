# Copy to infra/config.env and fill in. Every line here is read by infra/tierbook-up.
#
# The file is sourced, not parsed, so it is shell. Keep it out of version control: it names an account's resources.

# --- which side to create, and which to adopt ------------------------------------------------------------------------
# auto      adopt what is already there, create what is not          (the usual choice)
# create    create, and fail if it already exists
# existing  adopt, and fail if it is not there                       (never creates, never charges for new resources)
# skip      leave this side out entirely
TIERBOOK_GATEWAY=auto
TIERBOOK_CLUSTER=auto

# --- the gateway ------------------------------------------------------------------------------------------------------
# The prefix reaches every stack name, the ECS cluster and service, and the ECR repository. A prefix already in use is
# adopted rather than deployed into; a new one gets its own isolated set of stacks beside whatever else exists.
TIERBOOK_GATEWAY_PREFIX=tierbook1
TIERBOOK_GATEWAY_REGION=us-east-1
# Required to CREATE: the gateway seeds its first administrator from this, and without an administrator no API key can
# be issued, so tierbook has no way in.
TIERBOOK_GATEWAY_ADMIN_EMAIL=

# The image build is the only step that needs a container runtime. Either name one that exists here, or name a host to
# build on and leave this machine out of it.
#TIERBOOK_CONTAINER_CLI=finch
#TIERBOOK_IMAGE_BUILDER=i-0123456789abcdef0
#TIERBOOK_IMAGE_BUILDER_USER=ec2-user

# --- the cluster ------------------------------------------------------------------------------------------------------
TIERBOOK_CLUSTER_NAME=tierbook-candidates
TIERBOOK_CLUSTER_REGION=ap-northeast-1
# Required to CREATE. Terraform state for a cluster must not live only on a laptop: losing it means the cluster cannot
# be destroyed, which is the expensive failure rather than the annoying one.
TIERBOOK_CLUSTER_STATE_BUCKET=
#TIERBOOK_CLUSTER_LOCK_TABLE=
#TIERBOOK_VPC_CIDR=10.42.0.0/16
#TIERBOOK_KUBERNETES_VERSION=1.35

# --- the served box ---------------------------------------------------------------------------------------------------
TIERBOOK_BOX_MODEL=Qwen/Qwen2.5-1.5B-Instruct
TIERBOOK_BOX_INSTANCE=g6e.xlarge
TIERBOOK_BOX_POOL=gpu-dev
# memory + shmSize both count against the same container limit, and their sum has to fit the SMALLEST node the pool can
# pick. Getting this wrong does not leave a pod Pending: the scheduler reports insufficient memory, the autoscaler reads
# that as "add a bigger node", and it adds node after node. The serving chart records eleven for one replica.
TIERBOOK_BOX_MEMORY=16Gi
TIERBOOK_BOX_SHM=4Gi
TIERBOOK_BOX_CPU=2
TIERBOOK_BOX_MAX_MODEL_LEN=4096
# The engine's own admission limit. Left empty it is read from the engine's startup log, which is where it actually
# lives. Without it, nothing downstream can tell a saturated box from a starved one.
#TIERBOOK_BOX_SEATS=
# Which tool-call parser the engine should use. Model-specific, so there is no sensible default for every model.
#TIERBOOK_TOOL_CALL_PARSER=hermes

# --- the metered arm --------------------------------------------------------------------------------------------------
TIERBOOK_API_MODEL=
# NOT derived and NOT defaulted, and this is the one value the script refuses to continue without. The box's price is
# computed from a measured token rate; this one is a published list price. They are different kinds of fact, and a guess
# here would sit in the record beside a measurement looking identical to it.
TIERBOOK_API_PRICE_PER_MTOK=

# --- the measurement --------------------------------------------------------------------------------------------------
# Arrival rate, not concurrency. The probe schedules arrivals and does not wait for replies, which is what forms a queue
# -- and a queue is the only thing a deadline can be missed against.
TIERBOOK_PROBE_RATE_PER_SECOND=96
TIERBOOK_PROBE_SECONDS=60
TIERBOOK_PROBE_DEADLINE_SECONDS=8
# What the loop's service has to carry. The example's policy reads it; the mechanism has no opinion about it.
TIERBOOK_REQUIRED_PER_HOUR=100
