{
  "config_format": 1,
  "_comment": "Replace every value here. Nothing in this file is measured, and tierbook refuses to load it if you add a key that only a measurement may set.",
  "candidates": {
    "reference-api": {
      "deployment": "api",
      "endpoint": {
        "base_url": "https://your-gateway.example/v1",
        "model": "your-strong-model",
        "wire": "chat",
        "api_key_env": "TIERBOOK_API_KEY"
      },
      "price_per_mtok": {"fresh_in": 3.0, "cached_in": 0.3, "out": 15.0},
      "note": "whatever you would send everything to if you were not routing"
    },
    "cheap-api": {
      "deployment": "api",
      "endpoint": {
        "base_url": "https://your-gateway.example/v1",
        "model": "your-cheap-model",
        "wire": "chat",
        "api_key_env": "TIERBOOK_API_KEY"
      },
      "price_per_mtok": {"fresh_in": 0.3, "cached_in": 0.03, "out": 1.2}
    },
    "self-hosted": {
      "deployment": "self_hosted",
      "endpoint": {
        "base_url": "http://your-model-service.your-namespace.svc.cluster.local:8000/v1",
        "model": "the-name-that-service-answers-to",
        "wire": "chat"
      },
      "hourly_usd": 12.0,
      "note": "the hourly bill is required: a machine bills while idle, so without it the cost per request cannot be computed at all"
    }
  },
  "families": {
    "your-traffic-family": "reference-api"
  },
  "objective": {
    "objective": "cost",
    "constraints": {
      "non_inferiority": {"margin": 0.15}
    }
  }
}
