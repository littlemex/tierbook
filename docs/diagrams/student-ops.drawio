=Helvetica;fontSize=16;fontColor=#1E7E5A;fontStyle=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="86" y="640" width="1428" height="46" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;arcSize=23;absoluteArcSize=1;fillColor=#FFF6E5;strokeColor=#CDE9DC;strokeWidth=1;shadow=0;dashed=0;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="1440" height="46" as="geometry"/></mxCell><mxCell id="c41" value="tierbook still did not certify it at 0.85 (held-out lower bound 0.842-0.847 on 600 items) -- the certificate, not the hope, decides the switch" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#B7791F;fontStyle=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="86" y="700" width="1428" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>