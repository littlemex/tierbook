<mxfile><diagram name="student-ops"><mxGraphModel dx="1600" dy="800" grid="0" pageWidth="1600" pageHeight="800" background="#F7FBF9"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=0;absoluteArcSize=1;fillColor=#F7FBF9;strokeColor=none;strokeWidth=1;shadow=0;dashed=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="800" as="geometry"/></mxCell><mxCell id="c2" value="A task type moves from the teacher to a student only when the student has earned it" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontColor=#14442F;fontStyle=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="50" as="geometry"/></mxCell><mxCell id="c3" value="The large model is scaffolding. The loop around it is what tierbook adds." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#3E5248;fontStyle=0;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="34" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=12;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;shadow=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="330" height="160" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=6;absoluteArcSize=1;fillColor=#2B3A4A;strokeColor=none;strokeWidth=1;shadow=0;dashed=0;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="10" height="160" as="geometry"/></mxCell><mxCell id="c6" value="1  teacher answers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=23;fontColor=#14442F;fontStyle=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="100" y="152" width="294" height="34" as="geometry"/></mxCell><mxCell id="c7" value="a large model or a decision&lt;br&gt;model serves and labels&lt;br&gt;traffic for a while" style="text;html=1;wh